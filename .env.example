# 复制本文件为 .env 后再填写。不要把填好的 .env 提交到 git。
# cp .env.example .env

# 阿里云百炼（DashScope）API Key。北京地域的 Key 配北京的地址。
# 获取：https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=

# 千问，OpenAI 兼容接口。国内默认用北京共享域名。
# 若控制台给了专属域名，改成 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Paraformer / CosyVoice 的 WebSocket。代码里用官方文档里的 bearer 头。
# 专属域名示例：wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# 三个模型可以单独换，工厂函数只认这三个名字。
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
# cosyvoice-v2 的 longxiaochun_v2 支持 24000 Hz，和播放采样率一致。
# 想试更快的音色可以把模型改成 cosyvoice-v3-flash，音色改成 longanyang，
# 同时确认该音色支持的采样率，并把 DASHSCOPE_TTS_SAMPLE_RATE 改成同一个数。
DASHSCOPE_TTS_MODEL=cosyvoice-v2
DASHSCOPE_TTS_VOICE=longxiaochun_v2
DASHSCOPE_TTS_SAMPLE_RATE=24000

# 浏览器和服务器要使用同一组 STUN。本机 localhost 演示不依赖 STUN。
# 国内网络下 stun.l.google.com 经常连不上，所以默认用国内地址。
ICE_SERVERS=stun:stun.qq.com:3478,stun:stun.miwifi.com:3478

# Silero VAD。start 越大越不容易被咳嗽打断；stop 越小，用户一停我们就尽快去请求大模型。
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
VAD_MIN_VOLUME=0.6

# 用户停说之后，再等这么久收 Paraformer 的定稿。太大则首包变慢，太小则可能拿半句去问模型。
ASR_FINALIZE_TIMEOUT=0.35

HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
