# 复制本文件为 .env 后再填写。不要把填好的 .env 提交到 git。
# Windows:  Copy-Item .env.example .env
# macOS / Linux:  cp .env.example .env

# 阿里云百炼 API Key。新工作空间的密钥一般以 sk-ws- 开头。
# 获取：https://help.aliyun.com/zh/model-studio/get-api-key
# 不要把真实密钥写进这个 example 文件。
DASHSCOPE_API_KEY=

# 工作空间专属域名，只写主机名。控制台密钥旁边能看到，形如：
#   ws-<工作空间ID>.cn-beijing.maas.aliyuncs.com
# 下面的 xxxxxxxx 是占位符，必须换成你自己的工作空间 ID。
# 填了这一行之后，千问和语音会分别用：
#   https://<主机名>/compatible-mode/v1
#   wss://<主机名>/api-ws/v1/inference
# 语音这条路径在专属域名上可用（和共享域名的 /api-ws/v1/inference 相同）。
DASHSCOPE_HOST=ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com

# 也可以只填工作空间 ID，程序会拼成 ws-<ID>.cn-beijing.maas.aliyuncs.com。
# 和 DASHSCOPE_HOST 同时存在时，以 DASHSCOPE_HOST 为准。
# DASHSCOPE_WORKSPACE_ID=

# 一般不用填。只有在要单独换某一条地址时才取消注释。
# 一旦写了，就会盖住上面的 DASHSCOPE_HOST。共享域名 dashscope.aliyuncs.com
# 自 2026-09-30 起进入维护，新密钥不要再写回去。
# DASHSCOPE_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_WS_URL=wss://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference

# 三个模型可以单独换，工厂函数只认这三个名字。
DASHSCOPE_LLM_MODEL=qwen-plus
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
# cosyvoice-v2 的 longxiaochun_v2 支持 24000 Hz，和播放采样率一致。
# 想试更快的音色可以把模型改成 cosyvoice-v3-flash，音色改成 longanyang，
# 同时确认该音色支持的采样率，并把 DASHSCOPE_TTS_SAMPLE_RATE 改成同一个数。
DASHSCOPE_TTS_MODEL=cosyvoice-v2
DASHSCOPE_TTS_VOICE=longxiaochun_v2
DASHSCOPE_TTS_SAMPLE_RATE=24000

# 浏览器和服务器要使用同一组 STUN。本机 localhost 演示不依赖 STUN。
# 国内网络下 stun.l.google.com 经常连不上，所以默认用国内地址。
ICE_SERVERS=stun:stun.qq.com:3478,stun:stun.miwifi.com:3478

# Silero VAD。start 越大越不容易被咳嗽打断；stop 越小，用户一停我们就尽快去请求大模型。
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
VAD_MIN_VOLUME=0.6

# 用户停说之后，再等这么久收 Paraformer 的定稿。太大则首包变慢，太小则可能拿半句去问模型。
ASR_FINALIZE_TIMEOUT=0.35

HOST=0.0.0.0
PORT=7860
LOG_LEVEL=INFO
